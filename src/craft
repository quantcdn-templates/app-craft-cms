#!/usr/bin/env php
<?php
/**
 * Craft console bootstrap file
 */

define('CRAFT_BASE_PATH', __DIR__);
define('CRAFT_VENDOR_PATH', CRAFT_BASE_PATH . '/vendor');

// Composer autoloader
require_once CRAFT_VENDOR_PATH . '/autoload.php';

// Load environment variables. Immutable: a variable that is already set (Quant
// Cloud secrets and variables, docker compose `environment:`) wins over .env,
// which only fills in what is missing. The entrypoint creates .env from
// .env.example, so a mutable load would replace those values with local defaults.
if (class_exists('Dotenv\Dotenv') && file_exists(CRAFT_BASE_PATH . '/.env')) {
    Dotenv\Dotenv::createUnsafeImmutable(CRAFT_BASE_PATH)->safeLoad();
}

// Bootstrap Craft
define('CRAFT_ENVIRONMENT', getenv('CRAFT_ENVIRONMENT') ?: 'production');

$app = require CRAFT_VENDOR_PATH . '/craftcms/cms/bootstrap/console.php';
$exitCode = $app->run();
exit($exitCode);
